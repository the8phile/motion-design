{
  "name": "kopia-ad",
  "private": true,
  "version": "1.0.0",
  "description": "Motion design ad for Kopia, campus printing and delivery in Cameroon",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render KopiaAdVertical out/kopia-ad-9x16.mp4",
    "still": "remotion still KopiaAdVertical out/still.png",
    "typecheck": "tsc",
    "audio": "python3 scripts/make_music.py && python3 scripts/make_sfx.py && python3 scripts/mix_audio.py"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.532",
    "@remotion/fonts": "^4.0.532",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
